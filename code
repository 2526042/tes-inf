                if (playerData.shieldLevel < 5 && playerData.coins >= cost) {
                    playerData.coins -= cost;
                    playerData.shieldLevel++;
                    saveGameData();
                }
            });


            document.getElementById('buyMagnetBtn').addEventListener('click', () => {
                const cost = playerData.magnetLevel * 120;
                if (playerData.magnetLevel < 5 && playerData.coins >= cost) {
                    playerData.coins -= cost;
                    playerData.magnetLevel++;
                    saveGameData();
                }
            });


            document.getElementById('buyBombBtn').addEventListener('click', () => {
                const cost = 200;
                if (playerData.coins >= cost) {
                    playerData.coins -= cost;
                    playerData.bombs++;
                    saveGameData();
                }
